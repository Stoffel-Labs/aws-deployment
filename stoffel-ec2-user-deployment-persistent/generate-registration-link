#!/bin/sh
# Issues one operator-restricted, single-use WebAuthn registration link. Writes the row
# directly to ClientRegistrationsTable via AWS credentials (same write-path pattern as
# ./upload-program for ProgramsTable - no Lambda in this half; register_client.py only ever
# claims a row that already exists, never creates one from scratch). The printed link works
# exactly once: register_client.py's ConditionExpression rejects a second POST for the same
# token.
#
# The registration itself is restricted (this link), reusable (once registered, the identity
# works for every future execution/program - no re-registration), and general-purpose
# (nothing here mentions a program or slot - client_name is just one more identity a later
# ./run-program's --clients list can reference at whatever slot it chooses).
#
# Usage: ./generate-registration-link [label]
#   e.g.: ./generate-registration-link "Alice"
set -e

STACK="StoffelEc2UserDeploymentPersistentStack"
LABEL="${1:-}"

get_output() {
    aws cloudformation describe-stacks --stack-name "$STACK" \
        --query "Stacks[0].Outputs[?OutputKey=='$1'].OutputValue" \
        --output text
}

TABLE=$(get_output ClientRegistrationsTableName)
if [ -z "$TABLE" ] || [ "$TABLE" = "None" ]; then
    echo "ERROR: could not resolve ClientRegistrationsTableName from stack $STACK - has it been deployed?" >&2
    exit 1
fi
API_URL=$(get_output ApiUrl)
if [ -z "$API_URL" ] || [ "$API_URL" = "None" ]; then
    echo "ERROR: could not resolve ApiUrl from stack $STACK" >&2
    exit 1
fi
WEB_URL=$(get_output WebUrl)
if [ -z "$WEB_URL" ] || [ "$WEB_URL" = "None" ]; then
    echo "ERROR: could not resolve WebUrl from stack $STACK" >&2
    exit 1
fi

# 32 random bytes, hex-encoded - same generation pattern submit_execution.py already uses
# for execution_id (os.urandom(32).hex()). client_name is derived from the token itself
# (its first 24 hex characters), not a central counter, so concurrent registrations never
# race on assigning a name.
TOKEN=$(python3 -c "import os; print(os.urandom(32).hex())")
CLIENT_NAME="client-$(echo "$TOKEN" | cut -c1-24)"
NOW=$(python3 -c "from datetime import datetime, timezone; print(datetime.now(timezone.utc).isoformat())")

PUT_ITEM=$(python3 -c "
import json, sys
token, client_name, label, now = sys.argv[1:5]
item = {
    'token': {'S': token},
    'client_name': {'S': client_name},
    'created_at': {'S': now},
}
if label:
    item['label'] = {'S': label}
print(json.dumps(item))
" "$TOKEN" "$CLIENT_NAME" "$LABEL" "$NOW")

aws dynamodb put-item \
    --table-name "$TABLE" \
    --item "$PUT_ITEM" \
    --condition-expression "attribute_not_exists(#t)" \
    --expression-attribute-names '{"#t":"token"}' \
    >/dev/null

echo "Registered client_name: $CLIENT_NAME"
[ -n "$LABEL" ] && echo "Label: $LABEL"
echo ""
echo "Send this one-time link to the person registering (works once):"
LINK="${WEB_URL%/}/register.html?token=${TOKEN}&api=${API_URL%/}"
if [ -n "$LABEL" ]; then
    # Passed through so register.js can use it as the passkey's own name/displayName - without
    # this, every passkey created (this site's registration is the only place that name gets
    # set) shows up identically as "voter" in the OS/password-manager's own passkey list, with
    # no way to tell different registrants' credentials apart.
    ENCODED_LABEL=$(python3 -c "import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))" "$LABEL")
    LINK="${LINK}&label=${ENCODED_LABEL}"
fi
echo "$LINK"
