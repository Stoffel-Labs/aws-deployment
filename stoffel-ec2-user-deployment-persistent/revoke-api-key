#!/bin/sh
# Revoke (delete) a user's API key, along with the dedicated per-key usage plan
# ./add-api-key created for it (see that script - each key gets its own plan so it can carry
# its own rate limit). Does NOT need `cdk deploy` - deletes both directly via the AWS CLI.
# Immediately invalidates the key.
# Usage: ./revoke-api-key <username>
set -e

USER="$1"

if [ -z "$USER" ]; then
    echo "Usage: $0 <username>" >&2
    exit 1
fi

KEY_NAME="stoffel-$USER"
PLAN_NAME="$KEY_NAME-plan"

KEY_ID=$(aws apigateway get-api-keys --name-query "$KEY_NAME" --query "items[?name=='$KEY_NAME'].id" --output text)

if [ -z "$KEY_ID" ] || [ "$KEY_ID" = "None" ]; then
    echo "ERROR: no API key named '$KEY_NAME' found" >&2
    exit 1
fi

aws apigateway delete-api-key --api-key "$KEY_ID"
echo "Revoked API key '$KEY_NAME' (id: $KEY_ID)" >&2

PLAN_ID=$(aws apigateway get-usage-plans --query "items[?name=='$PLAN_NAME'].id" --output text)
if [ -n "$PLAN_ID" ] && [ "$PLAN_ID" != "None" ]; then
    aws apigateway delete-usage-plan --usage-plan-id "$PLAN_ID"
    echo "Deleted usage plan '$PLAN_NAME' (id: $PLAN_ID)" >&2
fi
