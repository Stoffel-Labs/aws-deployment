#!/bin/sh
# Run a Stoffel client against the deployed standing mesh.
#
# Requires client-env.sh to exist (written by ./run-program or ./run) and
# --program (there's no single implicit program in standing mode - the
# client binary needs the local .stflb for its client-I/O manifest, the
# same file ./run-program's program_name/./run's program-name-or-path
# argument resolved server-side). --execution-id defaults to EXECUTION_ID
# from client-env.sh; pass it explicitly only to target a different
# execution.
#
# Requires the StoffelVM binary to be built: cargo build --release in ../StoffelVM/
#
# Usage: ./run-client <client_id> [inputs [client_index]] [--outputs N] --program <name-or-path> [--execution-id <id>]
#   Input client:  ./run-client 0 "1 2 3" --program aes
#   Output-only:   ./run-client 0 --outputs 2 --program aes

set -e

CLIENT_ID="${1:?Usage: $0 <client_id> [inputs [client_index]] [--outputs N] --program <name-or-path> [--execution-id <id>]}"
shift

INPUTS=""
CLIENT_INDEX=""
OUTPUTS=""
PROGRAM_OVERRIDE=""
EXECUTION_ID_OVERRIDE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --outputs) OUTPUTS="$2"; shift 2 ;;
        --program) PROGRAM_OVERRIDE="$2"; shift 2 ;;
        --execution-id) EXECUTION_ID_OVERRIDE="$2"; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *)
            if [ -z "$INPUTS" ]; then
                INPUTS="$1"
            else
                CLIENT_INDEX="$1"
            fi
            shift ;;
    esac
done

CLIENT_INDEX="${CLIENT_INDEX:-$CLIENT_ID}"

if [ -z "$PROGRAM_OVERRIDE" ]; then
    echo "ERROR: --program <name-or-path> is required (the local .stflb matching what's staged/running)" >&2
    exit 1
fi
case "$PROGRAM_OVERRIDE" in
    *.stflb) PROGRAM_BASENAME="$PROGRAM_OVERRIDE" ;;
    *)       PROGRAM_BASENAME="$PROGRAM_OVERRIDE.stflb" ;;
esac
case "$PROGRAM_BASENAME" in
    /*|./*|../*) PROGRAM_PATH="$PROGRAM_BASENAME" ;;
    *)           PROGRAM_PATH="$(pwd)/../programs/$PROGRAM_BASENAME" ;;
esac
if [ ! -f "$PROGRAM_PATH" ]; then
    echo "Program file not found at $PROGRAM_PATH" >&2
    exit 1
fi

if [ ! -f client-env.sh ]; then
    echo "client-env.sh not found — run ./run-program (API) or ./run (operator) first" >&2
    exit 1
fi

. ./client-env.sh

EXECUTION_ID="${EXECUTION_ID_OVERRIDE:-$EXECUTION_ID}"
if [ -z "$EXECUTION_ID" ]; then
    echo "Missing EXECUTION_ID (not in client-env.sh and no --execution-id given)" >&2
    exit 1
fi

N_PARTIES="${N_PARTIES:-5}"
THRESHOLD="${THRESHOLD:-1}"

SERVERS=""
i=0
while [ "$i" -lt "$N_PARTIES" ]; do
    VAR="PARTY${i}_PUBLIC_IP"
    IP=$(eval "echo \$$VAR")
    if [ -z "$IP" ] || [ "$IP" = "None" ]; then
        echo "Missing $VAR in client-env.sh" >&2
        exit 1
    fi
    PORT=$((16180 + i))
    ENTRY="${IP}:${PORT}"
    SERVERS="${SERVERS:+$SERVERS,}$ENTRY"
    i=$((i + 1))
done

IDS_DIR="$(pwd)/../ids"
BINARY="../StoffelVM/target/release/stoffel-run"

if [ ! -f "$BINARY" ]; then
    echo "Binary not found at $BINARY — run 'cargo build --release' in ../StoffelVM/" >&2
    exit 1
fi

set -- \
    --client \
    --program "$PROGRAM_PATH" \
    --servers "$SERVERS" \
    --n-parties "$N_PARTIES" \
    --threshold "$THRESHOLD" \
    --off-chain-coord "${COORD_PUBLIC_IP}:31415" \
    --execution-id "$EXECUTION_ID" \
    --cert "${IDS_DIR}/pub/clients/client${CLIENT_ID}.crt" \
    --key "${IDS_DIR}/priv/clients/client${CLIENT_ID}.der" \
    --timestamp 0

if [ -n "$INPUTS" ]; then
    set -- "$@" --inputs "$INPUTS" --client-index "$CLIENT_INDEX"
fi

if [ -n "$OUTPUTS" ]; then
    set -- "$@" --outputs "$OUTPUTS"
fi

RUST_BACKTRACE=1 exec "$BINARY" "$@"
