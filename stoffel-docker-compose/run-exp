#!/bin/sh
# Run an experiment N times: each iteration calls run-nodes (with whatever
# args are passed through) followed by get-results, storing that run's
# ping-matrix/benchmark CSV in values/run-<i>.csv. Once all N runs are done,
# aggregates the per-run min/max/avg ping RTT and BENCH_PP_SECS/BENCH_EXEC_SECS
# (already computed per-run by get-results) into overall min/max/avg stats
# across the N runs.
#
# Usage: ./run-exp <N> <program.stflb> [run-nodes options...]
#   e.g. ./run-exp 5 client_mul.stflb --num-parties 7 --threshold 2
#   Per-run output: values/run-1.csv .. values/run-<N>.csv

set -e

usage() { echo "Usage: $0 <N> <program.stflb> [run-nodes options...]" >&2; exit 1; }

case "$1" in -h|--help) usage ;; esac

N="${1:?$(usage)}"; shift
case "$N" in
    ''|*[!0-9]*) echo "Invalid N: $N (expected a positive integer)" >&2; usage ;;
esac
[ "$N" -ge 1 ] || { echo "Invalid N: $N (expected a positive integer)" >&2; usage; }
[ $# -ge 1 ] || usage

DIR="$(cd "$(dirname "$0")" && pwd)"
VALUES_DIR="$DIR/values"
mkdir -p "$VALUES_DIR"

I=1
while [ "$I" -le "$N" ]; do
    echo "=== Run $I/$N ==="
    "$DIR/run-nodes" "$@"
    echo "=== Waiting for results (20s) ==="
    sleep 20
    "$DIR/get-results" "$VALUES_DIR/run-$I.csv"
    I=$((I + 1))
done

echo ""
echo "=== Aggregating $N run(s) ==="

python3 -c "
import csv, os, sys

values_dir, n = sys.argv[1], int(sys.argv[2])

def empty(): return {'min': [], 'max': [], 'average': []}
ping, pp, exec_ = empty(), empty(), empty()

for i in range(1, n + 1):
    path = os.path.join(values_dir, f'run-{i}.csv')
    with open(path, newline='') as f:
        rows = list(csv.reader(f))
    # First 'min'/'max'/'average' rows (2 columns) belong to the ping-RTT
    # summary get-results writes right after the RTT matrix. The later
    # 4-column 'pp_secs'/'exec_secs' rows belong to the benchmark-time
    # summary table, which starts right after a ['', 'min', 'max', 'average']
    # header — track that header to disambiguate the two blocks.
    in_summary = False
    for row in rows:
        if row == ['', 'min', 'max', 'average']:
            in_summary = True
            continue
        if not in_summary and len(row) == 2 and row[0] in ping and row[1]:
            ping[row[0]].append(float(row[1]))
        elif in_summary and len(row) == 4 and row[0] in ('pp_secs', 'exec_secs'):
            target = pp if row[0] == 'pp_secs' else exec_
            if row[1]: target['min'].append(float(row[1]))
            if row[2]: target['max'].append(float(row[2]))
            if row[3]: target['average'].append(float(row[3]))

def report(name, d, unit):
    mins, maxs, avgs = d['min'], d['max'], d['average']
    print(f'{name}:')
    print(f'  min: {min(mins):.3f}{unit}  (n={len(mins)})' if mins else '  min: n/a')
    print(f'  max: {max(maxs):.3f}{unit}  (n={len(maxs)})' if maxs else '  max: n/a')
    print(f'  avg: {sum(avgs) / len(avgs):.3f}{unit}  (avg of {len(avgs)} per-run averages)' if avgs else '  avg: n/a')

report('Ping RTT', ping, 'ms')
report('Preprocessing time (BENCH_PP_SECS)', pp, 's')
report('Execution time (BENCH_EXEC_SECS)', exec_, 's')
" "$VALUES_DIR" "$N"
