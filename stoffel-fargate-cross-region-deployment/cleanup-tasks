#!/bin/sh
# Stop all running ECS tasks across every region used by this deployment
# (coordinator + all 10 party regions). Use this to free up vCPUs after a
# failed or stuck run.
#
# Usage: ./cleanup-tasks
set -e

. "$(dirname "$0")/regions"

stop_cluster_tasks() {
    # stop_cluster_tasks <region> <stack>
    REGION="$1"
    STACK="$2"
    CLUSTER=$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$REGION" \
        --query "Stacks[0].Outputs[?OutputKey=='ClusterName'].OutputValue" \
        --output text 2>/dev/null)
    if [ -z "$CLUSTER" ] || [ "$CLUSTER" = "None" ]; then
        echo "  $STACK ($REGION): not deployed, skipping"
        return 0
    fi

    TASK_ARNS=$(aws ecs list-tasks --region "$REGION" --cluster "$CLUSTER" --desired-status RUNNING \
        --query 'taskArns' --output text)
    if [ -z "$TASK_ARNS" ] || [ "$TASK_ARNS" = "None" ]; then
        echo "  $STACK ($REGION): no running tasks"
        return 0
    fi

    echo "  $STACK ($REGION): stopping tasks in $CLUSTER..."
    for ARN in $TASK_ARNS; do
        aws ecs stop-task --region "$REGION" --cluster "$CLUSTER" --task "$ARN" --reason "manual cleanup" \
            --query 'task.taskArn' --output text
    done
    # stop-task returns as soon as the stop is requested; the task still
    # holds its vCPU reservation until DEPROVISIONING finishes. Wait for
    # that so a run-nodes retry right after doesn't hit vCPU limits again.
    echo "$TASK_ARNS" | xargs aws ecs wait tasks-stopped --region "$REGION" --cluster "$CLUSTER" --tasks
}

echo "Cleaning up coordinator..."
stop_cluster_tasks "$COORD_REGION" "StoffelCoordinatorStack"

IDX=0
while [ "$IDX" -le 9 ]; do
    REGION=$(party_region "$IDX")
    echo "Cleaning up party${IDX}..."
    stop_cluster_tasks "$REGION" "StoffelParty${IDX}Stack"
    IDX=$((IDX + 1))
done

echo "Done."
