#!/usr/bin/env python3
"""Generate docker-compose.yml for N mp-spdz ECDSA party containers.

Usage: ./gen-docker-compose --binary <prefix> [--n-parties <n>] [--n-runs <n>]
                             [--extra-flags "<flags>"] [-o <file>]
  e.g.: ./gen-docker-compose --binary rep --n-parties 3 --n-runs 50
        ./gen-docker-compose --binary mascot --n-parties 2 --n-runs 50 --extra-flags "-C -B"

Writes docker-compose.yml next to this script by default (pass -o - for stdout).
run-sig-bench calls this automatically, so docker-compose.yml always matches
the options it was given.
"""

import argparse
import os

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))


def gen(binary: str, n_parties: int, n_runs: int, extra_flags: str) -> str:
    lines = [
        "networks:",
        "  mpspdz:",
        "    driver: bridge",
        "",
        "# Common build + entrypoint config shared by all party containers.",
        "x-party: &party",
        "  build:",
        "    context: ../mp-spdz",
        "    dockerfile: ../mp-spdz-docker-compose/Dockerfile",
        "    additional_contexts:",
        "      - scripts=../mp-spdz-docker-compose",
        "  cap_add: [NET_ADMIN]",
        "  networks: [mpspdz]",
        "",
        "# Environment variables shared by all parties (see entrypoint.sh).",
        "x-common-env: &common-env",
        f'  BIN: "{binary}"',
        f'  N_PARTIES: "{n_parties}"',
        f'  N_RUNS: "{n_runs}"',
        f'  EXTRA_FLAGS: "{extra_flags}"',
        '  HOST: "party0"',
        '  PORT_BASE: "5000"',
        '  NET_LOSS: "${NET_LOSS:-}"',
        '  NET_BANDWIDTH: "${NET_BANDWIDTH:-}"',
        '  NET_DELAY: "${NET_DELAY:-}"',
        "",
        "services:",
    ]

    for i in range(n_parties):
        lines += [
            f"  party{i}:",
            "    <<: *party",
            "    environment:",
            "      <<: *common-env",
            f'      PARTY_ID: "{i}"',
        ]
        if i > 0:
            lines += [
                "    depends_on:",
                "      party0:",
                "        condition: service_started",
            ]
        lines.append("")

    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", default="rep",
                         help="ECDSA binary prefix, e.g. rep, shamir, mal-rep, "
                              "mal-shamir, mascot, semi (default: rep)")
    parser.add_argument("--n-parties", type=int, default=3)
    parser.add_argument("--n-runs", type=int, default=10)
    parser.add_argument("--extra-flags", default="",
                         help='e.g. "-C -B" for MASCOT-')
    parser.add_argument("-o", "--output",
                         default=os.path.join(SCRIPT_DIR, "docker-compose.yml"),
                         help="Output file, or - for stdout")
    args = parser.parse_args()

    out = gen(args.binary, args.n_parties, args.n_runs, args.extra_flags)

    if args.output == "-":
        print(out)
    else:
        with open(args.output, "w") as f:
            f.write(out)


if __name__ == "__main__":
    main()
