#!/bin/sh

CLUSTER=$1

# 1. Get all running task ARNs in the cluster
TASKS=$(aws ecs list-tasks --cluster $CLUSTER --query 'taskArns' --output text)

if [ -n "$TASKS" ]; then
    # 2. Get the Task Definition ARNs for those tasks
    TASK_DEFS=$(aws ecs describe-tasks --cluster $CLUSTER --tasks $TASKS --query 'tasks[*].taskDefinitionArn' --output text)
    
    echo "Log Groups for cluster $CLUSTER:"
    # 3. Loop through definitions, extract the log group names, and remove duplicates
    for DEF in $TASK_DEFS; do
        aws ecs describe-task-definition --task-definition $DEF \
        --query 'taskDefinition.containerDefinitions[*].logConfiguration.options."awslogs-group"' \
        --output text
    done | tr '\t' '\n' | sort | uniq
else
    echo "No running tasks found in the cluster."
fi
