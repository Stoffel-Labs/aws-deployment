#!/bin/sh
set -e

usage() {
    echo "Usage: $0 [log-env-file] [output-csv]" >&2
    echo "  Reads log stream names from log-env.sh (written by ./run-nodes) and" >&2
    echo "  aggregates each container's post-run ping output into an RTT matrix," >&2
    echo "  written as CSV. Row/column 0 is the coordinator, row/column i+1 is" >&2
    echo "  node i. (default log-env-file: log-env.sh, default output: ping-matrix.csv)" >&2
    exit 1
}

case "$1" in -h|--help) usage ;; esac

LOG_ENV="${1:-log-env.sh}"
OUT_CSV="${2:-ping-matrix.csv}"

[ -f "$LOG_ENV" ] || { echo "ERROR: $LOG_ENV not found. Run ./run-nodes first." >&2; exit 1; }
. "$LOG_ENV"

[ -n "$LOG_GROUP" ] || { echo "ERROR: LOG_GROUP not set in $LOG_ENV" >&2; exit 1; }
[ -n "$COORD_LOG_STREAM" ] || { echo "ERROR: COORD_LOG_STREAM not set in $LOG_ENV" >&2; exit 1; }

# Every container's ping loop runs right before it exits, so the ping output
# for a task is only complete once that task has stopped. Without this wait,
# reading the logs mid-run would silently yield a partial matrix.
if [ -n "$ALL_TASK_ARNS" ] && [ -n "$CLUSTER" ]; then
    echo "Waiting for all node tasks to stop (so ping output is complete)..."
#    echo "$ALL_TASK_ARNS" | xargs aws ecs wait tasks-stopped --cluster "$CLUSTER" --tasks
fi

RAW=$(mktemp)
trap 'rm -f "$RAW"' EXIT

# Pull every log line from a stream (paginating through get-log-events) and
# tag each one with the entity name it came from, e.g. "coord\t<message>".
fetch_stream() {
    LABEL="$1"
    STREAM="$2"
    TOKEN=""
    while :; do
        if [ -z "$TOKEN" ]; then
            PAGE=$(aws logs get-log-events --log-group-name "$LOG_GROUP" --log-stream-name "$STREAM" \
                --start-from-head --limit 10000 --output json)
        else
            PAGE=$(aws logs get-log-events --log-group-name "$LOG_GROUP" --log-stream-name "$STREAM" \
                --start-from-head --limit 10000 --next-token "$TOKEN" --output json)
        fi
        echo "$PAGE" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for e in data['events']:
    print('$LABEL\t' + e['message'])
" >> "$RAW"
        NEXT=$(echo "$PAGE" | python3 -c "import json,sys; print(json.load(sys.stdin).get('nextForwardToken',''))")
        COUNT=$(echo "$PAGE" | python3 -c "import json,sys; print(len(json.load(sys.stdin)['events']))")
        [ "$COUNT" = "0" ] && break
        [ "$NEXT" = "$TOKEN" ] && break
        TOKEN="$NEXT"
    done
}

echo "Fetching ping log lines..."
echo "  coordinator..."
fetch_stream "coord" "$COORD_LOG_STREAM"

IDX=0
while [ "$IDX" -le 9 ]; do
    eval "STREAM=\$PARTY${IDX}_LOG_STREAM"
    if [ -n "$STREAM" ]; then
        echo "  node${IDX}..."
        fetch_stream "node${IDX}" "$STREAM"
    fi
    IDX=$((IDX + 1))
done

python3 -c "
import csv, re, sys

entries = []  # (source, message)
with open(sys.argv[2]) as f:
    for line in f:
        source, _, message = line.rstrip('\n').partition('\t')
        if source:
            entries.append((source, message))

node_indices = sorted(
    {int(m.group(1)) for src, _ in entries if (m := re.fullmatch(r'node(\d+)', src))}
)
entities = ['coord'] + [f'node{i}' for i in node_indices]

# Ping targets are logged as 'coordinator' or 'partyN'; map them onto the
# same entity names used for sources ('coord' / 'nodeN').
def normalize_target(target):
    if target == 'coordinator':
        return 'coord'
    m = re.fullmatch(r'party(\d+)', target)
    return f'node{m.group(1)}' if m else None

rtts = {}  # (source, target) -> avg rtt ms
pending_target = None
for source, message in entries:
    m = re.match(r'Pinging (\S+)\.\.\.', message)
    if m:
        pending_target = normalize_target(m.group(1))
        continue
    m = re.search(r'rtt min/avg/max/mdev = [\d.]+/([\d.]+)/[\d.]+/[\d.]+ ms', message)
    if m and pending_target:
        rtts[(source, pending_target)] = float(m.group(1))
        pending_target = None

def cell(i, j):
    if i == j:
        return ''
    a, b = entities[i], entities[j]
    fwd, back = rtts.get((a, b)), rtts.get((b, a))
    if fwd is not None and back is not None:
        return f'{(fwd + back) / 2:.3f}'
    if fwd is not None:
        return f'{fwd:.3f}'
    if back is not None:
        return f'{back:.3f}'
    return ''

with open(sys.argv[1], 'w', newline='') as f:
    writer = csv.writer(f)
    for i in range(len(entities)):
        writer.writerow([cell(i, j) for j in range(len(entities))])

print(f'Wrote {len(entities)}x{len(entities)} RTT matrix to {sys.argv[1]}')
" "$OUT_CSV" "$RAW"
