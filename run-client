#!/bin/sh
# Usage: ./run-client <client_id> <inputs> [client_index]
#
# Requires client-env.sh to exist (generated by run-nodes).
# Requires the StoffelVM binary to be built: cargo build --release in StoffelVM/

set -e

CLIENT_ID="${1:?Usage: $0 <client_id> <inputs> [client_index]}"
INPUTS="${2:?Usage: $0 <client_id> <inputs> [client_index]}"
CLIENT_INDEX="${3:-$CLIENT_ID}"

if [ ! -f client-env.sh ]; then
    echo "client-env.sh not found — run ./run-nodes first" >&2
    exit 1
fi

. ./client-env.sh

# Build --servers from the party public IPs written by run-nodes
N_PARTIES=5
SERVERS=""
i=0
while [ "$i" -lt "$N_PARTIES" ]; do
    VAR="PARTY${i}_PUBLIC_IP"
    IP=$(eval "echo \$$VAR")
    if [ -z "$IP" ] || [ "$IP" = "None" ]; then
        echo "Missing $VAR in client-env.sh" >&2
        exit 1
    fi
    PORT=$((16180 + i))
    ENTRY="${IP}:${PORT}"
    SERVERS="${SERVERS:+$SERVERS,}$ENTRY"
    i=$((i + 1))
done

IDS_DIR="$(pwd)/ids"
BINARY="StoffelVM/target/release/stoffel-run"

if [ ! -f "$BINARY" ]; then
    echo "Binary not found at $BINARY — run 'cargo build --release' in StoffelVM/" >&2
    exit 1
fi

RUST_LOG=info RUST_BACKTRACE=1 exec "$BINARY" \
    --client \
    --inputs "$INPUTS" \
    --servers "$SERVERS" \
    --n-parties 5 \
    --threshold 1 \
    --off-chain-coord "${COORD_PUBLIC_IP}:31415" \
    --cert "${IDS_DIR}/pub/clients/client${CLIENT_ID}.crt" \
    --key "${IDS_DIR}/priv/clients/client${CLIENT_ID}.der" \
    --timestamp 0 \
    --client-index "$CLIENT_INDEX"
