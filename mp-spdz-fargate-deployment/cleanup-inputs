#!/bin/sh
# Remove all player input files from EFS so the next run starts clean.
#
# Usage: ./cleanup-inputs

set -e

IDENTITY="$(dirname "$0")/bastion-key"
STACK="MpSpdzStack"

get_output() {
    aws cloudformation describe-stacks --stack-name "$STACK" \
        --query "Stacks[0].Outputs[?OutputKey=='$1'].OutputValue" \
        --output text
}

BASTION_IP=$(get_output BastionPublicIp)
if [ -z "$BASTION_IP" ] || [ "$BASTION_IP" = "None" ]; then
    echo "ERROR: could not retrieve BastionPublicIp from stack $STACK" >&2
    exit 1
fi

EFS_ID=$(get_output EfsId)

if ! ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" "mountpoint -q /mnt/programs 2>/dev/null"; then
    echo "EFS not mounted on bastion — mounting now..."
    ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" \
        "sudo mount -t efs -o tls,iam ${EFS_ID}:/ /mnt/programs"
fi

ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" \
    "sudo rm -rf /mnt/programs/inputs && echo 'EFS:/inputs/ removed.'"
