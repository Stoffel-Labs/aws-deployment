#!/bin/sh
# Upload compiled MP-SPDZ bytecode from ./programs/ to EFS via the bastion.
# Requires ./compile-program to have been run first.
#
# Usage: ./upload-program <program_name> [-i <identity-file>]
#   e.g. ./upload-program tutorial

set -e

usage() {
    echo "Usage: $0 <program_name> [-i <identity-file>]" >&2
    exit 1
}

PROGRAM="${1:?}"; shift
IDENTITY="$(dirname "$0")/bastion-key"
while [ $# -gt 0 ]; do
    case "$1" in
        -i) IDENTITY="$2"; shift 2 ;;
        *)  echo "Unknown option: $1" >&2; usage ;;
    esac
done
if ! ls "programs/Bytecode/${PROGRAM}"-*.bc > /dev/null 2>&1; then
    echo "ERROR: no bytecode found for '${PROGRAM}' in programs/Bytecode/" >&2
    echo "  Run: ./compile-program Programs/Source/${PROGRAM}.mpc" >&2
    exit 1
fi

STACK="MpSpdzStack"

get_output() {
    aws cloudformation describe-stacks --stack-name "$STACK" \
        --query "Stacks[0].Outputs[?OutputKey=='$1'].OutputValue" \
        --output text
}

BASTION_IP=$(get_output BastionPublicIp)
if [ -z "$BASTION_IP" ] || [ "$BASTION_IP" = "None" ]; then
    echo "ERROR: could not retrieve BastionPublicIp from stack $STACK" >&2
    exit 1
fi

EFS_ID=$(get_output EfsId)

if ! ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" \
        "mountpoint -q /mnt/programs 2>/dev/null"; then
    echo "EFS not mounted on bastion — mounting now..."
    ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" \
        "sudo mount -t efs -o tls,iam ${EFS_ID}:/ /mnt/programs"
fi

ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" \
    "sudo mkdir -p /mnt/programs/Bytecode /mnt/programs/Schedules"

echo "Uploading bytecode..."
for f in "programs/Bytecode/${PROGRAM}"-*.bc; do
    name=$(basename "$f")
    ssh -i "$IDENTITY" -o StrictHostKeyChecking=no "ec2-user@$BASTION_IP" \
        "sudo tee '/mnt/programs/Bytecode/${name}' > /dev/null" < "$f"
    echo "  $name"
done

if [ -f "programs/Schedules/${PROGRAM}.sch" ]; then
    echo "Uploading schedule..."
    ssh -i "$IDENTITY" -o StrictHostKeyChecking=no "ec2-user@$BASTION_IP" \
        "sudo tee /mnt/programs/Schedules/${PROGRAM}.sch > /dev/null" \
        < "programs/Schedules/${PROGRAM}.sch"
fi

echo "Done. Run './run-nodes $PROGRAM <protocol> <n_parties>' to start players."
