#!/bin/sh
# Run a Stoffel client against the deployed EC2 cluster.
#
# Requires client-env.sh to exist (generated by run-nodes, or by a job
# submitted through the API - see run-program).
# Requires the StoffelVM binary to be built: cargo build --release in ../StoffelVM/
#
# Usage: ./run-client <client_id> [inputs [client_index]] [--outputs N]
#   Input client:  ./run-client 0 "1 2 3"
#   Output-only:   ./run-client 0 --outputs 2

set -e

CLIENT_ID="${1:?Usage: $0 <client_id> [inputs [client_index]] [--outputs N]}"
shift

INPUTS=""
CLIENT_INDEX=""
OUTPUTS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --outputs) OUTPUTS="$2"; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *)
            if [ -z "$INPUTS" ]; then
                INPUTS="$1"
            else
                CLIENT_INDEX="$1"
            fi
            shift ;;
    esac
done

CLIENT_INDEX="${CLIENT_INDEX:-$CLIENT_ID}"

if [ ! -f client-env.sh ]; then
    echo "client-env.sh not found — run ./run-nodes first, or submit a job via ./run-program" >&2
    exit 1
fi

. ./client-env.sh

# N_PARTIES/THRESHOLD come from client-env.sh (written by run-nodes, or
# recorded from a job's own params if client-env.sh was hand-written to
# match a job's endpoints); fall back to the deployment defaults.
N_PARTIES="${N_PARTIES:-5}"
THRESHOLD="${THRESHOLD:-1}"

SERVERS=""
i=0
while [ "$i" -lt "$N_PARTIES" ]; do
    VAR="PARTY${i}_PUBLIC_IP"
    IP=$(eval "echo \$$VAR")
    if [ -z "$IP" ] || [ "$IP" = "None" ]; then
        echo "Missing $VAR in client-env.sh" >&2
        exit 1
    fi
    PORT=$((16180 + i))
    ENTRY="${IP}:${PORT}"
    SERVERS="${SERVERS:+$SERVERS,}$ENTRY"
    i=$((i + 1))
done

IDS_DIR="$(pwd)/../ids"
BINARY="../StoffelVM/target/release/stoffel-run"

if [ ! -f "$BINARY" ]; then
    echo "Binary not found at $BINARY — run 'cargo build --release' in ../StoffelVM/" >&2
    exit 1
fi

set -- \
    --client \
    --servers "$SERVERS" \
    --n-parties "$N_PARTIES" \
    --threshold "$THRESHOLD" \
    --off-chain-coord "${COORD_PUBLIC_IP}:31415" \
    --cert "${IDS_DIR}/pub/clients/client${CLIENT_ID}.crt" \
    --key "${IDS_DIR}/priv/clients/client${CLIENT_ID}.der" \
    --timestamp 0

if [ -n "$INPUTS" ]; then
    set -- "$@" --inputs "$INPUTS" --client-index "$CLIENT_INDEX"
fi

if [ -n "$OUTPUTS" ]; then
    set -- "$@" --outputs "$OUTPUTS"
fi

RUST_BACKTRACE=1 exec "$BINARY" "$@"
