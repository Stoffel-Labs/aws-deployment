#!/bin/sh
# Print the current status of a job (one-shot, no polling).
# API_URL defaults to this deployment's endpoint; only set it to override.
# Usage: API_KEY=... ./get-program-status <job_id>
set -e

DEFAULT_API_URL="https://0wcij9fhh5.execute-api.eu-north-1.amazonaws.com/prod"

usage() {
    echo "Usage: API_KEY=... $0 <job_id>" >&2
    exit 1
}

[ $# -lt 1 ] && usage
JOB_ID="$1"

if [ -z "$API_KEY" ]; then
    echo "ERROR: API_KEY is not set." >&2
    exit 1
fi
API_URL="${API_URL:-$DEFAULT_API_URL}"
API_URL="${API_URL%/}"

RESPONSE=$(curl -sf "$API_URL/jobs/$JOB_ID" -H "x-api-key: $API_KEY") || {
    echo "ERROR: curl failed (exit $?) fetching status for $JOB_ID" >&2
    exit 1
}
echo "$RESPONSE" | python3 -m json.tool
