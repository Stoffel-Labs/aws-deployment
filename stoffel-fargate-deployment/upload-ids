#!/bin/sh
set -e

usage() {
    echo "Usage: $0 <local-ids-dir> [-i <identity-file>]" >&2
    echo "  e.g.: $0 ../ids -i ~/.ssh/stoffel-bastion.pem" >&2
    exit 1
}

LOCAL_DIR="$1"
[ -z "$LOCAL_DIR" ] && usage
[ -d "$LOCAL_DIR" ] || { echo "ERROR: $LOCAL_DIR is not a directory" >&2; exit 1; }
shift

# Default to bastion-key generated by ./gen-keypair
IDENTITY="$(dirname "$0")/bastion-key"
while [ $# -gt 0 ]; do
    case "$1" in
        -i) IDENTITY="$2"; shift 2 ;;
        *)  echo "Unknown option: $1" >&2; usage ;;
    esac
done
STACK="StoffelVMCoordinatorStack"

get_output() {
    aws cloudformation describe-stacks --stack-name "$STACK" \
        --query "Stacks[0].Outputs[?OutputKey=='$1'].OutputValue" \
        --output text
}

BASTION_IP=$(get_output BastionPublicIp)

if [ -z "$BASTION_IP" ] || [ "$BASTION_IP" = "None" ]; then
    echo "ERROR: could not retrieve BastionPublicIp from stack $STACK" >&2
    exit 1
fi

EFS_ID=$(get_output EfsId)

if [ -z "$EFS_ID" ] || [ "$EFS_ID" = "None" ]; then
    echo "ERROR: could not retrieve EfsId from stack $STACK" >&2
    exit 1
fi

# Ensure EFS is mounted on the bastion before uploading.
# The user-data mount can fail if EFS mount targets weren't ready at boot time,
# which would silently upload the files to local disk instead of EFS.
if ! ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" \
        "mountpoint -q /mnt/efs 2>/dev/null"; then
    echo "EFS not mounted on bastion — mounting now..."
    ssh -i "$IDENTITY" -o StrictHostKeyChecking=no ec2-user@"$BASTION_IP" \
        "sudo mkdir -p /mnt/efs && sudo mount -t efs -o tls,iam ${EFS_ID}:/ /mnt/efs && sudo mkdir -p /mnt/efs/programs /mnt/efs/ids"
    echo "  mounted."
fi

echo "Uploading $LOCAL_DIR/ to $BASTION_IP:/mnt/efs/ids/ ..."
scp -r -i "$IDENTITY" -o StrictHostKeyChecking=no "$LOCAL_DIR/." "ec2-user@$BASTION_IP:/mnt/efs/ids/"
echo "Done."
