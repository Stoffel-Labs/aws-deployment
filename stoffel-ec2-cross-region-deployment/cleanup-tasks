#!/bin/sh
# Stop the running Stoffel container (if any) on every node's EC2 instance,
# across all regions used by this deployment. Unlike the Fargate deployment,
# the instances themselves stay up — this only kills a stuck container so a
# fresh ./run-nodes can start a clean one.
#
# Usage: ./cleanup-tasks
set -e

. "$(dirname "$0")/regions"

CONTAINER_NAME="stoffel-run"

stop_container() {
    # stop_container <stack> <region>
    STACK="$1"
    REGION="$2"
    INSTANCE=$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$REGION" \
        --query "Stacks[0].Outputs[?OutputKey=='InstanceId'].OutputValue" \
        --output text 2>/dev/null)
    if [ -z "$INSTANCE" ] || [ "$INSTANCE" = "None" ]; then
        echo "  $STACK ($REGION): not deployed, skipping"
        return 0
    fi

    echo "  $STACK ($REGION): stopping container on $INSTANCE..."
    PARAMS_FILE=$(mktemp)
    python3 -c "
import json, sys
instance, container = sys.argv[1:3]
print(json.dumps({
    'DocumentName': 'AWS-RunShellScript',
    'InstanceIds': [instance],
    'Parameters': {'commands': [f'docker rm -f {container} >/dev/null 2>&1 || true']},
}))
" "$INSTANCE" "$CONTAINER_NAME" > "$PARAMS_FILE"
    CMD_ID=$(aws ssm send-command --region "$REGION" --cli-input-json "file://$PARAMS_FILE" \
        --query 'Command.CommandId' --output text 2>/dev/null)
    rm -f "$PARAMS_FILE"
    if [ -z "$CMD_ID" ]; then
        echo "    could not send SSM command (instance may not be registered yet)"
        return 0
    fi

    ELAPSED=0
    while :; do
        STATUS=$(aws ssm get-command-invocation --region "$REGION" --command-id "$CMD_ID" --instance-id "$INSTANCE" \
            --query 'Status' --output text 2>/dev/null || echo "Pending")
        case "$STATUS" in
            Success) break ;;
            Cancelled|TimedOut|Failed|Cancelling) echo "    docker rm failed: $STATUS"; break ;;
        esac
        if [ "$ELAPSED" -ge 60 ]; then
            echo "    still $STATUS after 60s, giving up"
            break
        fi
        sleep 5
        ELAPSED=$((ELAPSED + 5))
    done
}

echo "Cleaning up coordinator..."
stop_container "StoffelCoordinatorStack" "$COORD_REGION"

IDX=0
while [ "$IDX" -le 9 ]; do
    REGION=$(party_region "$IDX")
    echo "Cleaning up party${IDX}..."
    stop_container "StoffelParty${IDX}Stack" "$REGION"
    IDX=$((IDX + 1))
done

echo "Done."
