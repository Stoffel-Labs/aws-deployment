#!/bin/sh
set -e

# Starts the coordinator + every party EC2 instance back up after
# ./stop-nodes. Elastic IPs re-attach automatically (they never detached),
# so no CDK redeploy or address-book rebuild is needed — just wait for
# instances to boot and the SSM agent to come back up before running
# ./run-nodes (usually well under a minute).
#
# Must match stop-nodes'/run-nodes' DEPLOYED_PARTIES.
DEPLOYED_PARTIES=5

. "$(dirname "$0")/regions"

get_output() {
    # get_output <stack> <region> <output-key>
    aws cloudformation describe-stacks --stack-name "$1" --region "$2" \
        --query "Stacks[0].Outputs[?OutputKey=='$3'].OutputValue" \
        --output text
}

start_instance() {
    REGION="$1"; INSTANCE="$2"; LABEL="$3"
    echo "Starting $LABEL ($INSTANCE in $REGION)..."
    aws ec2 start-instances --region "$REGION" --instance-ids "$INSTANCE" >/dev/null
}

wait_instance() {
    REGION="$1"; INSTANCE="$2"; LABEL="$3"
    echo "Waiting for $LABEL ($INSTANCE in $REGION) to reach running state..."
    aws ec2 wait instance-running --region "$REGION" --instance-ids "$INSTANCE"
}

# STARTED accumulates "region|instance|label" lines so we can wait on
# everything after all start requests have been sent.
STARTED=""

COORD_INSTANCE=$(get_output "StoffelCoordinatorStack" "$COORD_REGION" InstanceId)
if [ -z "$COORD_INSTANCE" ] || [ "$COORD_INSTANCE" = "None" ]; then
    echo "ERROR: could not resolve StoffelCoordinatorStack InstanceId in $COORD_REGION — has it been deployed?" >&2
    exit 1
fi
start_instance "$COORD_REGION" "$COORD_INSTANCE" "coordinator"
STARTED="${STARTED}${COORD_REGION}|${COORD_INSTANCE}|coordinator
"

LAST_PARTY=$((DEPLOYED_PARTIES - 1))
IDX=0
while [ "$IDX" -le "$LAST_PARTY" ]; do
    REGION=$(party_region "$IDX")
    STACK="StoffelParty${IDX}Stack"
    INSTANCE=$(get_output "$STACK" "$REGION" InstanceId)
    if [ -z "$INSTANCE" ] || [ "$INSTANCE" = "None" ]; then
        echo "ERROR: could not resolve $STACK InstanceId in $REGION — has it been deployed?" >&2
        exit 1
    fi
    start_instance "$REGION" "$INSTANCE" "party${IDX}"
    STARTED="${STARTED}${REGION}|${INSTANCE}|party${IDX}
"
    IDX=$((IDX + 1))
done

echo ""
echo "Start requests sent for all $((DEPLOYED_PARTIES + 1)) instances. Waiting for them to enter running state..."
echo ""

OLD_IFS="$IFS"
IFS='
'
for ENTRY in $STARTED; do
    IFS="$OLD_IFS"
    REGION=$(echo "$ENTRY" | cut -d'|' -f1)
    INSTANCE=$(echo "$ENTRY" | cut -d'|' -f2)
    LABEL=$(echo "$ENTRY" | cut -d'|' -f3)
    wait_instance "$REGION" "$INSTANCE" "$LABEL"
    IFS='
'
done
IFS="$OLD_IFS"

echo ""
echo "All $((DEPLOYED_PARTIES + 1)) instances are running."
echo "Give the SSM agent a few more seconds to come up, then run ./run-nodes as usual."
