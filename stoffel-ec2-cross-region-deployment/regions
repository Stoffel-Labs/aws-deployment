#!/bin/sh
# Region assignment shared by run-nodes, upload-program, run-client, run-exp,
# get-aws-logs, and cleanup-tasks. Values live in regions.conf — this just
# loads that file and provides the party_region() lookup helper.
#
# /bin/sh has no arrays, so PARTY_REGIONS is a space-separated list; index it
# with: set -- $PARTY_REGIONS; eval "REGION=\${$((i + 1))}"

. "$(dirname "$0")/regions.conf"

# party_region <index> — echoes the region for party <index> (0-based).
party_region() {
    i="$1"
    set -- $PARTY_REGIONS
    eval "echo \${$((i + 1))}"
}
