#!/bin/sh
# Upload a compiled program from the repo-root ./programs/ (built by
# ../build-programs) to the shared S3 bucket that every party region
# downloads from at run-nodes time (replaces the bastion/EFS scp flow used
# by stoffel-fargate-deployment — S3 is reachable from every region).
set -e

. "$(dirname "$0")/regions"

usage() {
    echo "Usage: $0 <program-name>" >&2
    echo "  e.g.: $0 client_mul          (looks for ../programs/client_mul.stflb)" >&2
    echo "        $0 client_mul.stflb" >&2
    exit 1
}

ARG="${1:?$(usage)}"
case "$ARG" in
    *.stflb) NAME="$ARG" ;;
    *)       NAME="$ARG.stflb" ;;
esac

LOCAL_FILE="$(dirname "$0")/../programs/$NAME"
if [ ! -f "$LOCAL_FILE" ]; then
    echo "ERROR: $NAME not found in $(dirname "$0")/../programs/" >&2
    echo "  Run: ./build-programs (from the repo root) to build it" >&2
    exit 1
fi

STACK="StoffelCoordinatorStack"

BUCKET=$(aws cloudformation describe-stacks --stack-name "$STACK" --region "$COORD_REGION" \
    --query "Stacks[0].Outputs[?OutputKey=='ProgramsBucketName'].OutputValue" \
    --output text)

if [ -z "$BUCKET" ] || [ "$BUCKET" = "None" ]; then
    echo "ERROR: could not retrieve ProgramsBucketName from stack $STACK in $COORD_REGION" >&2
    exit 1
fi

echo "Uploading $NAME to s3://$BUCKET/ ..."
aws s3 cp "$LOCAL_FILE" "s3://$BUCKET/$NAME" --region "$COORD_REGION"
echo "Done. Run './run-nodes $NAME' to start the nodes."
