#!/bin/sh
# Start the cross-region cluster and run N clients sequentially.
# The i-th client (0-indexed) is invoked as:
#   run-client i "i,i,...,i" i*COUNT
# where "i,i,...,i" repeats i COUNT times (COUNT = --client-input-count, default 1)
# and the reserved client-index is the start of that client's block of COUNT
# input slots.
#
# N is passed to run-nodes as --n-input-clients and COUNT as
# --client-input-count, so run-nodes can build the same expected-clients
# list (capped to the first N client certs in ../ids) and derive the same
# input total (N * COUNT) that the coordinator and parties are started
# expecting.
#
# --num-parties/--threshold (same defaults as run-nodes and run-client:
# 4/1) are passed through to both run-nodes and every run-client invocation,
# so the clients always dial the same topology the cluster was actually
# started with. Any other options (--backend, --curve) are passed through
# unchanged to run-nodes.
#
# Every run is a fresh one-off execution (see run-nodes); run-nodes writes
# the execution ID it used for the coordinator/parties into client-env.sh,
# and run-client defaults to it from there, so no --execution-id needs to
# be passed here.
#
# Usage: ./run-with-clients <program.stflb> <N> [--client-input-count <n>] [--num-parties <n>] [--threshold <t>] [--backend avss|honeybadger] [--curve <curve>]
#   e.g. ./run-with-clients client_mul.stflb 4 --client-input-count 3 --num-parties 4 --threshold 1

set -e

usage() { echo "Usage: $0 <program.stflb> <N> [--client-input-count <n>] [--num-parties <n>] [--threshold <t>] [--backend avss|honeybadger] [--curve <curve>]" >&2; exit 1; }

PROGRAM="${1:?$(usage)}"; shift
N="${1:?$(usage)}"; shift

CLIENT_INPUT_COUNT=1
NUM_PARTIES=4
THRESHOLD=1
REST_COUNT=$#
i=0
while [ "$i" -lt "$REST_COUNT" ]; do
    case "$1" in
        --client-input-count) CLIENT_INPUT_COUNT="$2"; shift 2; i=$((i + 2)) ;;
        --num-parties) NUM_PARTIES="$2"; set -- "$@" "$1" "$2"; shift 2; i=$((i + 2)) ;;
        --threshold) THRESHOLD="$2"; set -- "$@" "$1" "$2"; shift 2; i=$((i + 2)) ;;
        *) set -- "$@" "$1"; shift; i=$((i + 1)) ;;
    esac
done

DIR="$(cd "$(dirname "$0")" && pwd)"

"$DIR/run-nodes" "$PROGRAM" --n-input-clients "$N" --client-input-count "$CLIENT_INPUT_COUNT" "$@"

i=0
while [ "$i" -lt "$N" ]; do
    INPUTS=""
    j=0
    while [ "$j" -lt "$CLIENT_INPUT_COUNT" ]; do
        INPUTS="${INPUTS:+$INPUTS,}$i"
        j=$((j + 1))
    done
    "$DIR/run-client" "$i" "$INPUTS" "$((i * CLIENT_INPUT_COUNT))" --num-parties "$NUM_PARTIES" --threshold "$THRESHOLD" --outputs 0 &
    echo "Started client $i"
    i=$((i + 1))
done
